# Frontend Environment Variables Template for NagarSeva DPI
# Note: In Vite, all client-exposed variables MUST start with VITE_

# 1. Backend API Base URL (Render deployed URL or empty if using vercel.json rewrites)
VITE_API_BASE_URL=https://nagarmitra-dpi-backend.onrender.com

# 2. Firebase Project 'nagar-seva' Configuration
# Found at: Firebase Console > Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=nagar-seva-fbae2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nagar-seva-fbae2
VITE_FIREBASE_STORAGE_BUCKET=nagar-seva-fbae2.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=635957390026
VITE_FIREBASE_APP_ID=1:635957390026:web:yourAppIdHere

# 3. Google OAuth Client ID (for Google Sign-In fallback)
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# 4. Google Maps API Key (Optional)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
